{
  "name": "foxdevstudio",
  "version": "0.1.0",
  "description": "FoxDev Studio - a modern Visual FoxPro style IDE",
  "main": "./out/main/index.js",
  "author": "Dev <dev@foxscript.org>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "package": "npm run build && electron-builder",
    "package:ci": "electron-builder --publish never",
    "build:wasm": "node scripts/build-wasm.mjs",
    "ensure-wasm": "node scripts/ensure-wasm.mjs",
    "pretypecheck": "npm run ensure-wasm",
    "pretest": "npm run ensure-wasm && npm run ensure-fllhost",
    "predev": "npm run ensure-native",
    "prebuild": "npm run ensure-native",
    "test:rust": "cargo test --workspace",
    "goldens:check": "node scripts/vfp-expected.mjs --check --all",
    "kimi": "node scripts/kimi.mjs",
    "argforms": "node scripts/arg-forms.mjs",
    "argforms:check": "node scripts/arg-forms.mjs --check",
    "version:check": "node scripts/version-check.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:rust && npm run argforms:check",
    "docs:reference": "node -e \"process.env.REGEN_DOCS='1';require('child_process').spawnSync(process.platform==='win32'?'npx.cmd':'npx',['vitest','run','tests/shared/languageReference'],{stdio:'inherit',env:process.env})\"",
    "build:ole": "node scripts/build-ole.mjs",
    "ensure-ole": "node scripts/ensure-ole.mjs",
    "build:fllhost": "node scripts/build-fllhost.mjs",
    "ensure-fllhost": "node scripts/ensure-fllhost.mjs",
    "ensure-native": "npm run ensure-wasm && npm run ensure-ole && npm run ensure-fllhost"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-icons": "^2.0.339",
    "@lezer/highlight": "^1.2.3",
    "iconv-lite": "^0.7.3",
    "immer": "^11.1.18",
    "koffi": "^3.2.1",
    "nanoid": "^5.1.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lint": "^6.9.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "5.9",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "wasm-pack": "^0.15.0"
  },
  "allowScripts": {
    "electron@44.2.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false,
    "wasm-pack@0.15.0": true,
    "koffi@3.2.1": false
  }
}
