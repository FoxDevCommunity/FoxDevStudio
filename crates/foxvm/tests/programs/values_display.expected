-- SET POINT and SET SEPARATOR
point [0_33][   1234_5678][  1,234_57]
sep [  1#234_57][1#234#567_80]
euro [  1.234,50][   1234,50][  3,70][  3,00]
reset [  1,234.57][  3.70][.,]
-- SET CURRENCY
dollar [ $1,234.56][ $1,234.56]
eur left [UR1,234.56][R-1,234.56]
eur right [  1,234.56EUR][ -1,234.56EUR]
readback [RIGHT][EUR]
reset [LEFT][$]
-- SET NULLDISPLAY
default [.NULL.][.NULL.]
set [<none>][<none>][<none>]
reset [.NULL.]
