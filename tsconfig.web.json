{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom/vitest"]
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/wasm/**/*", "src/preload/index.d.ts", "tests/**/*", "vitest.config.ts"],
