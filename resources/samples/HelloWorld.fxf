{
  "$schema": "foxdev-form",
  "version": 1,
  "form": {
    "name": "frmHello",
    "props": {
      "AutoCenter": true,
      "Caption": "Hello, World",
      "Height": 220,
      "Width": 400
    },
    "methods": {
      "Init": "* runs when the form is created\nTHISFORM.txtName.SetFocus()"
    },
    "children": [
      {
        "id": "lblName",
        "type": "Label",
        "name": "lblName",
        "props": {
          "Caption": "Your name:",
          "Left": 16,
          "Top": 20,
          "Width": 80
        },
        "methods": {}
      },
      {
        "id": "txtName",
        "type": "TextBox",
        "name": "txtName",
        "props": {
          "Left": 104,
          "Top": 16,
          "Width": 200
        },
        "methods": {}
      },
      {
        "id": "chkLoud",
        "type": "CheckBox",
        "name": "chkLoud",
        "props": {
          "Caption": "Shout it",
          "Left": 104,
          "Top": 48,
          "Width": 120
        },
        "methods": {}
      },
      {
        "id": "pgfMain",
        "type": "PageFrame",
        "name": "pgfMain",
        "props": {
          "Height": 90,
          "Left": 16,
          "Top": 76,
          "Width": 288
        },
        "methods": {},
        "children": [
          {
            "id": "pgfMain.Page1",
            "type": "Page",
            "name": "Page1",
            "props": {
              "Caption": "Greeting"
            },
            "methods": {},
            "children": [
              {
                "id": "lblGreeting",
                "type": "Label",
                "name": "lblGreeting",
                "props": {
                  "Caption": "(nothing yet)",
                  "Left": 8,
                  "Top": 8,
                  "Width": 200
                },
                "methods": {}
              }
            ]
          },
          {
            "id": "pgfMain.Page2",
            "type": "Page",
            "name": "Page2",
            "props": {
              "Caption": "About"
            },
            "methods": {},
            "children": []
          }
        ]
      },
      {
        "id": "cmdSayHi",
        "type": "CommandButton",
        "name": "cmdSayHi",
        "props": {
          "Caption": "Say Hi",
          "Default": true,
          "Left": 312,
          "Top": 16
        },
        "methods": {
          "Click": "LOCAL cMsg\ncMsg = \"Hello, \" + ALLTRIM(THISFORM.txtName.Value)\nIF THISFORM.chkLoud.Value\n  cMsg = UPPER(cMsg) + \"!\"\nENDIF\nTHISFORM.pgfMain.Page1.lblGreeting.Caption = cMsg"
        }
      },
      {
        "id": "cmdClose",
        "type": "CommandButton",
        "name": "cmdClose",
        "props": {
          "Cancel": true,
          "Caption": "Close",
          "Left": 312,
          "Top": 48
        },
        "methods": {
          "Click": "THISFORM.Release()"
        }
      }
    ]
  }
}
